class Solution {
public:
    vector<int> partitionLabels(string s) {
        
        int n=s.size();

        map<char,int>mp;

        int si=0;   // starting index

        for(int i=0;i<n;i++)
        {
            mp[s[i]]=i;
        }

        int maxi=0;

        vector<int>ans;

        for(int i=0;i<n;i++)
        {
            maxi=max(maxi,mp[s[i]]);

            if(maxi==i)
            {
               ans.push_back(i-si+1);
               si=i+1;
            }
        }


        return ans;
    }
};
