class Solution {
public:
    int jump(vector<int>& nums) {
        
        int n=nums.size();

        int jumps=0;
        int left=0,right=0;

        while(right<n-1)
        {
            int maxreach=0;

            for(int i=left;i<=right;i++)
            {
               maxreach=max(maxreach,i+nums[i]);
            }

            left=right+1;
            right=maxreach;
            jumps++;
        }


        return jumps;
    }
};
